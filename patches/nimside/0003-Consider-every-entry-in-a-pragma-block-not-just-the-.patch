From 4b9677e0a3550e63bfe5fcf552aad10cf3b05179 Mon Sep 17 00:00:00 2001
From: Dario Gabriel Lipicar <lipigl@gmail.com>
Date: Fri, 31 Jul 2026 16:14:54 -0300
Subject: [PATCH 3/6] Consider every entry in a pragma block, not just the
 first

findPragma inspected only n[0], so anything after the first entry in a pragma
block was silently ignored. `{.slot, raises: [].}` -- the form used in this
project's own README -- therefore never registered a slot: the method was
absent from the meta object, and QMetaObject::invokeMethod on it simply failed,
with no diagnostic anywhere to say why.

Iterate the block instead. findPragma now returns the matching entry rather
than the enclosing nnkPragma, which also removes the qprop[0] indexing at the
call site that assumed position zero.
---
 src/nimside.nim        | 14 ++++++++++----
 tests/test_all.nim     |  3 ++-
 tests/test_pragmas.nim | 36 ++++++++++++++++++++++++++++++++++++
 3 files changed, 48 insertions(+), 5 deletions(-)
 create mode 100644 tests/test_pragmas.nim

diff --git a/src/nimside.nim b/src/nimside.nim
index 4da4c7f..eb24140 100644
--- a/src/nimside.nim
+++ b/src/nimside.nim
@@ -53,10 +53,16 @@ proc extractTypeImpl(n: NimNode): NimNode =
     error("Invalid node to retrieve type implementation of: " & $n.kind)
 
 proc findPragma(n: NimNode, name: string): NimNode =
+  ## The matching entry within a pragma block, or nil.
+  ##
+  ## Every entry is considered, not just the first: `{.slot, raises: [].}` is
+  ## ordinary Nim, and only looking at index zero quietly ignores whatever
+  ## comes after it.
   case n.kind
   of nnkPragma:
-    if name.eqIdent(n[0]) or n[0].kind == nnkCall and name.eqIdent(n[0][0]):
-      return n
+    for entry in n:
+      if name.eqIdent(entry) or entry.kind == nnkCall and name.eqIdent(entry[0]):
+        return entry
   else:
     for nn in n:
       let x = findPragma(nn, name)
@@ -240,8 +246,8 @@ proc readType(n: NimNode): NimTypeDef =
             write = true
             notify = true
 
-          if qprop[0].kind == nnkCall:
-            for n in qprop[0][1 ..^ 1]:
+          if qprop.kind == nnkCall:
+            for n in qprop[1 ..^ 1]:
               case n.kind
               of nnkExprEqExpr:
                 if "write".eqIdent(n[0]):
diff --git a/tests/test_all.nim b/tests/test_all.nim
index 55c5c63..1e24446 100644
--- a/tests/test_all.nim
+++ b/tests/test_all.nim
@@ -1,2 +1,3 @@
 import
-  ./test_metaobjectgen
+  ./test_metaobjectgen,
+  ./test_pragmas
diff --git a/tests/test_pragmas.nim b/tests/test_pragmas.nim
new file mode 100644
index 0000000..15f0e4e
--- /dev/null
+++ b/tests/test_pragmas.nim
@@ -0,0 +1,36 @@
+import nimside, seaqt/[qobject, qmetaobject], seaqt/QtCore/gen_qmetaobject, unittest2
+
+# Declared at module scope: `qobject:` emits a type section plus `{.global.}`
+# state, which does not belong inside a test body.
+qobject:
+  type Counter = ref object of VirtualQObject
+    count {.qproperty(write = true, notify = true).}: int32
+
+  # `slot` deliberately not first. This is the shape nimside's own README uses
+  # (`{.slot, raises: [].}`), and it used to be silently ignored.
+  proc increment(self: Counter) {.raises: [], slot.} =
+    self.setCount(self.count + 1'i32)
+
+  proc reset(self: Counter) {.slot, raises: [].} =
+    self.setCount(0'i32)
+
+suite "Pragma parsing":
+  setup:
+    let o = Counter()
+    QObject.create(o)
+
+  test "a slot is found wherever it sits in the pragma block":
+    let mo = o.metaObject()
+    check(mo.indexOfSlot("increment()") >= 0)
+    check(mo.indexOfSlot("reset()") >= 0)
+
+  test "such a slot is really invokable, not merely listed":
+    check QMetaObject.invokeMethod(o[], "increment")
+    check o.count() == 1'i32
+    check QMetaObject.invokeMethod(o[], "reset")
+    check o.count() == 0'i32
+
+  test "a property declared alongside them still resolves":
+    let mo = o.metaObject()
+    check(mo.indexOfProperty("count") >= 0)
+    check mo.property(mo.indexOfProperty("count")).hasNotifySignal()
