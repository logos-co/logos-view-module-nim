+proc readEnum(n: NimNode): NimEnumDef =
+  ## Read an `nnkEnumTy` typedef into keys and values.
+  ##
+  ## Nim's own ordinals are not usable here: the meta object stores the value of
+  ## every key explicitly, and Qt consumers -- QML, a replica -- compare against
+  ## the numbers the interface declares, not against a position in a list.
+  expectKind(n, {nnkTypeDef})
+  result.name = $n[0].basename()
+
+  var next = 0'i32
+  for field in n[2]:
+    case field.kind
+    of nnkEmpty, nnkPragma:
+      continue # the enum's own pragmas, e.g. {.pure.}
+    of nnkIdent, nnkSym:
+      result.keys.add NimEnumKeyDef(name: $field, value: next)
+      next += 1
+    of nnkEnumFieldDef:
+      if field[1].kind != nnkIntLit:
+        error(
+          "enum values published to Qt must be integer literals, got " &
+            repr(field[1]),
+          field[1],
+        )
+      let v = field[1].intVal
+      if v < int32.low.int64 or v > int32.high.int64:
+        error("enum value out of range for Qt's 32-bit enumerators: " & $v, field[1])
+      result.keys.add NimEnumKeyDef(name: $field[0].basename(), value: int32(v))
+      next = int32(v) + 1
+    else:
+      error("unsupported enum field: " & $field.kind, field)
+
+proc toEnumDef(v: NimEnumDef): NimNode =
