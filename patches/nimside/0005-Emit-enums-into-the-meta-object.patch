+func isEnumType*(T: type): bool =
+  ## Whether `T` should be exposed to Qt as an enumerator rather than a builtin.
+  ## `bool` is an enum in Nim but Qt has a builtin for it.
+  when T is enum and T isnot bool: true else: false
