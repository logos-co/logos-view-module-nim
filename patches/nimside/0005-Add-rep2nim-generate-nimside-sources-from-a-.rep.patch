diff --git a/src/nimside/rep2nim.nim b/src/nimside/rep2nim.nim
new file mode 100644
index 0000000..f50140c
--- /dev/null
+++ b/src/nimside/rep2nim.nim
@@ -0,0 +1,394 @@
+## rep2nim -- generate nimside sources from a Qt Remote Objects `.rep` file.
+##
+## This is to nimside what `repc -o source` is to C++: given a replica
+## definition, emit the source-side object so that a `.rep` can be the single
+## definition of an interface shared between a Nim implementation and any
+## number of C++/QML replicas.
+##
+## What comes out is a complete `qobject:` block -- the type, its properties,
+## its signals and its slots -- where each slot body forwards to a proc you
+## write:
+##
+## .. code-block:: nim
+##   qobject:
+##     type Counter* = ref object of VirtualQObject
+##       count {.qproperty(write = true, notify = true).}: int32
+##
+##     include "counter_impl"
+##
+##     proc increment(self: Counter) {.slot.} =
+##       self.incrementImpl()
+##
+## The `include` splices your implementations into the block ahead of the slots
+## that call them, which is what makes them able to see both the generated type
+## and its generated property accessors. Write them as ordinary procs with no
+## pragmas -- `qobject:` passes anything that is neither a slot nor a signal
+## through untouched:
+##
+## .. code-block:: nim
+##   proc incrementImpl(self: Counter) =
+##     self.setCount(self.count + 1'i32)
+##
+## Declaration order is preserved throughout, because that is what the Qt meta
+## object -- and therefore anything reading it, `QtRemoteObjects`'
+## `DynamicApiMap` included -- keys off.
+
+import std/[algorithm, os, strformat, strutils, tables]
+
+type
+  Rep2NimError* = object of CatchableError ## Raised for anything malformed or
+                                           ## not yet supported. `line` is
+                                           ## 1-based, 0 when not tied to one.
+    line*: int
+
+  PropAccess* = enum
+    ## How a `PROP` may be reached. This describes the *replica* side; the
+    ## source always needs some way to set the value, so `Constant` is the only
+    ## one that produces no setter.
+    ReadWrite ## default
+    ReadOnly ## `READONLY` -- replica cannot write it
+    Constant ## `CONSTANT` -- never changes, so no setter and no notify
+
+  Param* = object
+    name*: string
+    typ*: string ## already mapped to Nim
+
+  Prop* = object
+    name*: string
+    typ*: string ## already mapped to Nim
+    access*: PropAccess
+
+  Method* = object
+    name*: string
+    returnType*: string ## already mapped to Nim; "void" for signals
+    params*: seq[Param]
+
+  Class* = object
+    name*: string
+    props*: seq[Prop]
+    signals*: seq[Method]
+    slots*: seq[Method]
+
+  Rep* = object
+    classes*: seq[Class]
+
+const
+  qtToNim = {
+    "void": "void",
+    "bool": "bool",
+    # .rep `int` is Qt's int, i.e. 32-bit. Nim's `int` is 64-bit and would land
+    # in the meta object as qlonglong, which silently mismatches every replica
+    # generated from the same .rep -- so never map anything to plain `int`.
+    "int": "int32",
+    "qint32": "int32",
+    "uint": "uint32",
+    "unsigned int": "uint32",
+    "quint32": "uint32",
+    "qint8": "int8",
+    "signed char": "int8",
+    "quint8": "uint8",
+    "uchar": "uint8",
+    "unsigned char": "uint8",
+    "short": "int16",
+    "qint16": "int16",
+    "ushort": "uint16",
+    "unsigned short": "uint16",
+    "quint16": "uint16",
+    "qint64": "int64",
+    "qlonglong": "int64",
+    "long long": "int64",
+    "quint64": "uint64",
+    "qulonglong": "uint64",
+    "unsigned long long": "uint64",
+    "float": "float32",
+    "double": "float64",
+    "qreal": "float64",
+    "QString": "string",
+    "QStringList": "seq[string]",
+  }.toTable
+
+  # Recognised by repc, deliberately not handled here rather than mis-generated.
+  unsupportedKeywords = {
+    "POD": "POD types have no nimside equivalent yet",
+    "MODEL":
+      "MODEL requires a QAbstractItemModel source, which nimside cannot express",
+    "CLASS": "nested CLASS sub-objects are not supported yet",
+    "USE_ENUM": "USE_ENUM is not supported yet",
+    "ENUM":
+      "nimside does not emit enums into the meta object yet, so an ENUM here " &
+      "would be silently dropped",
+  }.toTable
+
+proc err(line: int, msg: string) {.noreturn.} =
+  var e = newException(Rep2NimError, msg)
+  e.line = line
+  raise e
+
+proc mapType(line: int, qtType: string): string =
+  let t = qtType.strip()
+  if t.len == 0:
+    err(line, "empty type")
+  if t in qtToNim:
+    return qtToNim[t]
+  var supported: seq[string]
+  for k in qtToNim.keys:
+    supported.add k
+  sort(supported)
+  err(
+    line,
+    &"unsupported type '{t}'. rep2nim maps: " & supported.join(", ") &
+      ". Anything else would fall through to nimside's runtime metatype lookup " &
+      "and not match the replica.",
+  )
+
+proc splitTopLevel(s: string, sep: char): seq[string] =
+  ## Split on `sep`, ignoring separators nested inside <> (for QList<int> and
+  ## friends -- rejected later by mapType, but they must at least tokenise).
+  var depth = 0
+  var cur = ""
+  for c in s:
+    case c
+    of '<': inc depth; cur.add c
+    of '>': dec depth; cur.add c
+    else:
+      if c == sep and depth == 0:
+        result.add cur
+        cur = ""
+      else:
+        cur.add c
+  if cur.strip().len > 0 or result.len > 0:
+    result.add cur
+
+proc parseParams(line: int, inner: string): seq[Param] =
+  ## `int a, QString b` -> params. Unnamed parameters get positional names.
+  let body = inner.strip()
+  if body.len == 0:
+    return
+  for i, raw in splitTopLevel(body, ','):
+    let part = raw.strip()
+    if part.len == 0:
+      err(line, "empty parameter")
+    let sp = part.rfind(' ')
+    if sp < 0:
+      # A bare type with no name, e.g. SLOT(void fn(int)).
+      result.add Param(name: &"arg{i}", typ: mapType(line, part))
+    else:
+      result.add Param(
+        name: part[sp + 1 .. ^1].strip(), typ: mapType(line, part[0 ..< sp])
+      )
+
+proc parseCallable(line: int, inner: string, isSignal: bool): Method =
+  ## `void increment()` / `int add(int a, int b)` / `changed(int v)` for signals.
+  let open = inner.find('(')
+  let close = inner.rfind(')')
+  if open < 0 or close < open:
+    err(line, "expected `name(...)`, got: " & inner)
+
+  let head = inner[0 ..< open].strip()
+  result.params = parseParams(line, inner[open + 1 ..< close])
+
+  if isSignal:
+    # Signals have no return type in a .rep.
+    if head.contains(' '):
+      err(line, "a SIGNAL must not declare a return type: " & inner)
+    result.name = head
+    result.returnType = "void"
+  else:
+    let sp = head.rfind(' ')
+    if sp < 0:
+      err(line, "a SLOT must declare a return type, e.g. `void " & head & "()`")
+    result.name = head[sp + 1 .. ^1].strip()
+    result.returnType = mapType(line, head[0 ..< sp])
+
+  if result.name.len == 0:
+    err(line, "missing name in: " & inner)
+
+proc parseProp(line: int, inner: string): Prop =
+  ## `int count READONLY`, `QString name`, `int x=5`.
+  var body = inner.strip()
+
+  # Strip a default value; the source-side object initialises its own fields.
+  let eq = body.find('=')
+  if eq >= 0:
+    body = body[0 ..< eq].strip()
+
+  var words: seq[string]
+  for w in body.splitWhitespace():
+    words.add w
+  if words.len < 2:
+    err(line, "expected `PROP(<type> <name> [flags])`, got: " & inner)
+
+  result.access = ReadWrite
+  var consumed = words.len
+  # Trailing flags, in any order.
+  while consumed > 2:
+    case words[consumed - 1].toUpperAscii()
+    of "READONLY": result.access = ReadOnly
+    of "CONSTANT": result.access = Constant
+    of "READWRITE", "SOURCEONLYSETTER", "PERSISTED": discard
+    else:
+      err(line, "unknown PROP flag '" & words[consumed - 1] & "'")
+    dec consumed
+
+  result.name = words[consumed - 1]
+  result.typ = mapType(line, words[0 ..< consumed - 1].join(" "))
+
+proc parseRep*(source, filename: string): Rep =
+  ## Parse a `.rep`. Only the subset rep2nim can faithfully represent is
+  ## accepted; everything else repc understands is rejected by name so it
+  ## cannot be silently dropped.
+  var cur: Class
+  var inClass = false
+
+  var lineNo = 0
+  for rawLine in source.splitLines():
+    inc lineNo
+    var line = rawLine
+
+    # Comments.
+    let hash = line.find('#')
+    if hash == 0:
+      continue # #include and friends: irrelevant to the Nim side
+    let slashes = line.find("//")
+    if slashes >= 0:
+      line = line[0 ..< slashes]
+    line = line.strip()
+    if line.len == 0:
+      continue
+
+    # The leading keyword, however the declaration continues -- `ENUM E { .. }`
+    # carries no parentheses and `MODEL m(role)` puts the name before them, so
+    # neither can be recognised by splitting on '('.
+    let keyword = line.splitWhitespace()[0].split('(')[0]
+    if keyword in unsupportedKeywords:
+      err(lineNo, &"`{keyword}` is not supported by rep2nim: " &
+        unsupportedKeywords[keyword])
+
+    if not inClass:
+      if keyword == "class":
+        let name = line[5 .. ^1].strip().strip(chars = {'{', ' '})
+        if name.len == 0:
+          err(lineNo, "class needs a name")
+        cur = Class(name: name)
+        inClass = true
+        continue
+      if line in ["{", "}"]:
+        continue
+      err(lineNo, "unexpected: " & line)
+
+    if line == "{":
+      continue
+    if line == "}":
+      result.classes.add cur
+      inClass = false
+      continue
+
+    let open = line.find('(')
+    if open < 0:
+      err(lineNo, "unexpected: " & line)
+    let close = line.rfind(')')
+    if close < open:
+      err(lineNo, "unterminated `(` -- rep2nim needs one declaration per line")
+    let inner = line[open + 1 ..< close]
+
+    case keyword
+    of "PROP": cur.props.add parseProp(lineNo, inner)
+    of "SLOT": cur.slots.add parseCallable(lineNo, inner, isSignal = false)
+    of "SIGNAL": cur.signals.add parseCallable(lineNo, inner, isSignal = true)
+    else:
+      err(lineNo, "unknown declaration `" & keyword & "`")
+
+  if inClass:
+    err(0, &"unterminated class `{cur.name}` in {filename}")
+  if result.classes.len == 0:
+    err(0, &"no class found in {filename}")
+
+proc implName*(m: Method): string =
+  m.name & "Impl"
+
+proc signature(m: Method, className: string): string =
+  result = &"proc {m.name}*(self: {className}"
+  for p in m.params:
+    result.add &", {p.name}: {p.typ}"
+  result.add ")"
+  if m.returnType != "void":
+    result.add ": " & m.returnType
+
+proc implCall(m: Method): string =
+  result = "self." & m.implName() & "("
+  for i, p in m.params:
+    if i > 0:
+      result.add ", "
+    result.add p.name
+  result.add ")"
+
+proc generate*(rep: Rep, repPath, implModule: string): string =
+  ## Emit the nimside module for `rep`. `implModule` is `include`d inside the
+  ## `qobject:` block, ahead of the slots, so your procs can see the generated
+  ## types and property accessors.
+  let src = repPath.extractFilename()
+  result = &"""
+## Generated by rep2nim from {src} -- DO NOT EDIT.
+##
+## Implement the `*Impl` procs listed below in `{implModule}.nim`, as ordinary
+## procs with no pragmas.
+
+import nimside
+import seaqt/qobject
+
+qobject:
+  type
+"""
+
+  for c in rep.classes:
+    result.add &"    {c.name}* = ref object of VirtualQObject\n"
+    for p in c.props:
+      let (write, notify) =
+        case p.access
+        of Constant: ("false", "false")
+        # READONLY constrains the replica, not the source: the source still
+        # needs a setter to publish changes, and repc emits a change signal.
+        of ReadOnly, ReadWrite: ("true", "true")
+      result.add(
+        &"      {p.name} {{.qproperty(write = {write}, notify = {notify}).}}: {p.typ}" &
+          "\n"
+      )
+    if c.props.len == 0:
+      result.add "      discard\n"
+    result.add "\n"
+
+  result.add &"""  # Your implementations. Spliced in ahead of the slots that call them, so
+  # they can see the types above and their generated property accessors.
+  include "{implModule}"
+
+"""
+
+  # Everything below stays inside the `qobject:` block, hence the indent.
+  for c in rep.classes:
+    for m in c.signals:
+      result.add "  " & signature(m, c.name) & " {.signal.}\n"
+    if c.signals.len > 0:
+      result.add "\n"
+    for m in c.slots:
+      result.add "  " & signature(m, c.name) & " {.slot.} =\n"
+      result.add "    " & implCall(m) & "\n\n"
+
+proc implStub*(rep: Rep, implModule: string): string =
+  ## A starting point for the implementation module: one stub per slot.
+  result = &"""
+## Implementations for the slots declared in the generated rep2nim module.
+##
+## Included into its `qobject:` block, so the generated types and their
+## property accessors are in scope. Plain procs, no pragmas.
+
+"""
+  for c in rep.classes:
+    for m in c.slots:
+      var sig = &"proc {m.implName()}*(self: {c.name}"
+      for p in m.params:
+        sig.add &", {p.name}: {p.typ}"
+      sig.add ")"
+      if m.returnType != "void":
+        sig.add ": " & m.returnType
+      result.add sig & " =\n"
+      result.add "  discard # TODO\n\n"
diff --git a/src/rep2nim.nim b/src/rep2nim.nim
new file mode 100644
index 0000000..5b1a051
--- /dev/null
+++ b/src/rep2nim.nim
@@ -0,0 +1,85 @@
+## rep2nim -- generate nimside sources from a Qt Remote Objects `.rep` file.
+##
+##   rep2nim counter.rep                      # -> counter_rep.nim
+##   rep2nim counter.rep -o src/counter.nim
+##   rep2nim counter.rep --impl:counter_logic # module to include for the bodies
+##   rep2nim counter.rep --stub               # also write the impl stub, if absent
+
+import std/[os, parseopt, strformat]
+import nimside/rep2nim
+
+const usage =
+  """
+rep2nim -- repc for nimside
+
+  rep2nim <file.rep> [options]
+
+Options:
+  -o, --out:<path>    output module (default: <file>_rep.nim next to the input)
+      --impl:<module> module included for the slot bodies
+                      (default: <file>_impl)
+      --stub          also write <impl>.nim with one stub per slot,
+                      if it does not already exist
+  -h, --help
+"""
+
+proc main() =
+  var
+    repPath = ""
+    outPath = ""
+    implModule = ""
+    writeStub = false
+
+  for kind, key, val in getopt():
+    case kind
+    of cmdArgument:
+      if repPath.len > 0:
+        quit "rep2nim: one .rep at a time (got '" & key & "' as well)", 2
+      repPath = key
+    of cmdLongOption, cmdShortOption:
+      case key
+      of "o", "out": outPath = val
+      of "impl": implModule = val
+      of "stub": writeStub = true
+      of "h", "help":
+        echo usage
+        quit 0
+      else:
+        quit "rep2nim: unknown option --" & key & "\n\n" & usage, 2
+    of cmdEnd: discard
+
+  if repPath.len == 0:
+    quit usage, 2
+  if not repPath.fileExists():
+    quit "rep2nim: no such file: " & repPath, 2
+
+  let
+    dir = repPath.parentDir()
+    stem = repPath.extractFilename().changeFileExt("")
+  if outPath.len == 0:
+    outPath = dir / (stem & "_rep.nim")
+  if implModule.len == 0:
+    implModule = stem & "_impl"
+
+  let source = readFile(repPath)
+  var rep: Rep
+  try:
+    rep = parseRep(source, repPath)
+  except Rep2NimError as e:
+    let where = if e.line > 0: &"{repPath}({e.line})" else: repPath
+    quit &"{where}: {e.msg}", 1
+
+  createDir(outPath.parentDir())
+  writeFile(outPath, generate(rep, repPath, implModule))
+  echo "rep2nim: wrote ", outPath
+
+  if writeStub:
+    let stubPath = outPath.parentDir() / (implModule & ".nim")
+    if stubPath.fileExists():
+      echo "rep2nim: keeping existing ", stubPath
+    else:
+      writeFile(stubPath, implStub(rep, implModule))
+      echo "rep2nim: wrote ", stubPath
+
+when isMainModule:
+  main()
