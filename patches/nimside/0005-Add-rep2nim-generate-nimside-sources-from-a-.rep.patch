new file mode 100644
index 0000000..b7d26e6
--- /dev/null
+++ b/tests/test_rep2nim.nim
@@ -0,0 +1,206 @@
+import nimside/rep2nim, std/[sequtils, strutils], unittest2
+
+proc parse(s: string): Rep =
+  parseRep(s, "test.rep")
+
+proc failure(s: string): string =
+  try:
+    discard parseRep(s, "test.rep")
+    ""
+  except Rep2NimError as e:
+    e.msg
+
+suite "rep2nim parsing":
+  test "class with a property and a slot":
+    let rep = parse(
+      """
+class Counter
+{
+    PROP(int count READONLY)
+
+    SLOT(void increment())
+}
+"""
+    )
+    check rep.classes.len == 1
+    let c = rep.classes[0]
+    check c.name == "Counter"
+    check c.props.len == 1
+    check c.props[0].name == "count"
+    check c.props[0].access == ReadOnly
+    check c.slots.len == 1
+    check c.slots[0].name == "increment"
+    check c.slots[0].returnType == "void"
+    check c.slots[0].params.len == 0
+
+  test ".rep int is 32-bit, so it must not become Nim's int":
+    # Nim's `int` is 64-bit and would reach the meta object as qlonglong,
+    # silently mismatching every replica generated from the same .rep.
+    let c = parse("class C\n{\n    PROP(int n)\n}\n").classes[0]
+    check c.props[0].typ == "int32"
+
+  test "type mapping":
+    let c = parse(
+      """
+class C
+{
+    PROP(QString s)
+    PROP(QStringList l)
+    PROP(bool b)
+    PROP(double d)
+    PROP(qint64 big)
+    PROP(quint16 small)
+}
+"""
+    ).classes[0]
+    check c.props.mapIt(it.typ) ==
+      @["string", "seq[string]", "bool", "float64", "int64", "uint16"]
+
+  test "property flags":
+    let c = parse(
+      """
+class C
+{
+    PROP(int a)
+    PROP(int b READONLY)
+    PROP(int c CONSTANT)
+    PROP(int d READWRITE)
+    PROP(int e SOURCEONLYSETTER)
+}
+"""
+    ).classes[0]
+    check c.props.mapIt(it.access) ==
+      @[ReadWrite, ReadOnly, Constant, ReadWrite, ReadWrite]
+
+  test "a default value is dropped -- the source initialises its own fields":
+    let c = parse("class C\n{\n    PROP(int n=5)\n}\n").classes[0]
+    check c.props[0].name == "n"
+    check c.props[0].typ == "int32"
+
+  test "slots with parameters and a return type":
+    let c = parse(
+      """
+class C
+{
+    SLOT(int add(int a, int b))
+    SLOT(void take(QString s))
+}
+"""
+    ).classes[0]
+    check c.slots[0].name == "add"
+    check c.slots[0].returnType == "int32"
+    check c.slots[0].params.mapIt(it.name) == @["a", "b"]
+    check c.slots[0].params.mapIt(it.typ) == @["int32", "int32"]
+    check c.slots[1].returnType == "void"
+    check c.slots[1].params[0].typ == "string"
+
+  test "an unnamed parameter gets a positional name":
+    let c = parse("class C\n{\n    SLOT(void f(int))\n}\n").classes[0]
+    check c.slots[0].params[0].name == "arg0"
+
+  test "signals have no return type":
+    let c = parse("class C\n{\n    SIGNAL(changed(int v))\n}\n").classes[0]
+    check c.signals.len == 1
+    check c.signals[0].name == "changed"
+    check c.signals[0].returnType == "void"
+    check c.signals[0].params[0].name == "v"
+
+  test "comments and #include lines are ignored":
+    let c = parse(
+      """
+#include <QString>
+// leading comment
+class C
+{
+    PROP(int n) // trailing comment
+}
+"""
+    ).classes[0]
+    check c.props.len == 1
+
+  test "several classes keep their order":
+    let rep = parse(
+      "class A\n{\n    PROP(int a)\n}\nclass B\n{\n    PROP(int b)\n}\n"
+    )
+    check rep.classes.mapIt(it.name) == @["A", "B"]
+
+suite "rep2nim rejects what it cannot represent":
+  test "constructs repc supports but nimside cannot":
+    # Rejected by name rather than silently dropped.
+    for kw in ["POD Point(int x, int y)", "USE_ENUM(Foo)"]:
+      check failure(kw & "\n").contains("not supported")
+    for kw in ["ENUM E { A, B }", "MODEL m(role)", "CLASS sub(Other)"]:
+      check failure("class C\n{\n    " & kw & "\n}\n").contains("not supported")
+
+  test "an unmapped type is an error, not a guess":
+    let msg = failure("class C\n{\n    PROP(QColor c)\n}\n")
+    check msg.contains("QColor")
+    check msg.contains("unsupported type")
+
+  test "a slot must declare a return type":
+    check failure("class C\n{\n    SLOT(doIt())\n}\n").contains("return type")
+
+  test "a signal must not declare one":
+    check failure("class C\n{\n    SIGNAL(void changed())\n}\n").
+      contains("must not declare a return type")
+
+  test "unterminated class":
+    check failure("class C\n{\n    PROP(int n)\n").contains("unterminated")
+
+  test "no class at all":
+    check failure("\n// nothing here\n").contains("no class")
+
+  test "the error carries a line number":
+    try:
+      discard parseRep("class C\n{\n    PROP(QColor c)\n}\n", "test.rep")
+      check false
+    except Rep2NimError as e:
+      check e.line == 3
+
+suite "rep2nim generation":
+  let rep = parse(
+    """
+class Counter
+{
+    PROP(int count READONLY)
+    PROP(QString label CONSTANT)
+
+    SIGNAL(bumped(int by))
+    SLOT(void increment())
+    SLOT(int addTo(int base))
+}
+"""
+  )
+  let src = generate(rep, "counter.rep", "counter_impl")
+
+  test "emits a qobject block with the type and its properties":
+    check src.contains("qobject:")
+    check src.contains("Counter* = ref object of VirtualQObject")
+    check src.contains("count {.qproperty(write = true, notify = true).}: int32")
+
+  test "CONSTANT means no setter and no notify":
+    check src.contains("label {.qproperty(write = false, notify = false).}: string")
+
+  test "READONLY still gets a setter -- it constrains the replica, not the source":
+    check src.contains("count {.qproperty(write = true, notify = true).}")
+
+  test "includes the impl module ahead of the slots that call it":
+    let inc = src.find("include \"counter_impl\"")
+    let slot = src.find("proc increment*")
+    check inc >= 0
+    check slot > inc
+
+  test "slots forward to *Impl and stay inside the block":
+    check src.contains("  proc increment*(self: Counter) {.slot.} =\n" &
+      "    self.incrementImpl()")
+    check src.contains("  proc addTo*(self: Counter, base: int32): int32 {.slot.} =\n" &
+      "    self.addToImpl(base)")
+
+  test "signals are declared without a body":
+    check src.contains("  proc bumped*(self: Counter, by: int32) {.signal.}")
+
+  test "the stub declares one proc per slot":
+    let stub = implStub(rep, "counter_impl")
+    check stub.contains("proc incrementImpl*(self: Counter) =")
+    check stub.contains("proc addToImpl*(self: Counter, base: int32): int32 =")
+    check not stub.contains("bumped")
