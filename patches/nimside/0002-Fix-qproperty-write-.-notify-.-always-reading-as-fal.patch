From 4b80487e061769155d971b1770d1494f287dbd9f Mon Sep 17 00:00:00 2001
From: Dario Gabriel Lipicar <lipigl@gmail.com>
Date: Thu, 30 Jul 2026 00:11:31 -0300
Subject: [PATCH 2/3] Fix qproperty(write = ..., notify = ...) always reading
 as false

The pragma is parsed from an untyped AST, so `true` and `false` reach the macro
as plain identifiers. `NimNode.boolVal` does not understand identifiers and
reports `false` for both, so any property that spelled its arguments out lost
its setter and its notify signal -- silently, with no diagnostic:

    count {.qproperty(write = true, notify = true).}: int32

produced PropertyDef(readSlot: "count", writeSlot: "", notifySignal: ""), i.e.
a read-only, non-notifying property. Only the bare `{.qproperty.}` form, which
never reaches this branch, behaved as documented; `write = false` "worked"
purely because false is what boolVal returns for everything.

Compare the identifier instead, accept an int literal for good measure, and
turn anything else into a compile error at the offending node rather than a
silent false. Unknown argument names now `error()` at the argument too, instead
of raising a bare assert with no location.

tests/test_all: 22 OK.
---
 src/nimside.nim | 27 ++++++++++++++++++++++++---
 1 file changed, 24 insertions(+), 3 deletions(-)

diff --git a/src/nimside.nim b/src/nimside.nim
index 09d50ee..4da4c7f 100644
--- a/src/nimside.nim
+++ b/src/nimside.nim
@@ -190,6 +190,27 @@ proc genMethodCall(meth: NimMethodDef, name, obj, argv, offset: NimNode): NimNod
         store(`call`, `argv`[0])
   nnkStmtList.newTree(readParams, caller, delParams)
 
+proc qpropertyFlag(name, value: NimNode): bool =
+  ## Read a boolean `qproperty` argument.
+  ##
+  ## The pragma is parsed from an untyped AST, so `true` and `false` arrive as
+  ## plain identifiers -- `boolVal` does not understand those and quietly
+  ## reports `false` for both, which silently dropped the setter or the notify
+  ## signal for anyone who spelled the default out. Compare the identifier
+  ## instead, and reject anything that is not a literal rather than guessing.
+  if value.eqIdent("true"):
+    true
+  elif value.eqIdent("false"):
+    false
+  elif value.kind in {nnkIntLit, nnkUInt8Lit}:
+    value.intVal != 0
+  else:
+    error(
+      "qproperty `" & repr(name) & "` expects `true` or `false`, got " & repr(value),
+      value,
+    )
+    false
+
 proc readType(n: NimNode): NimTypeDef =
   expectKind(n, {nnkTypeDef})
   let
@@ -224,11 +245,11 @@ proc readType(n: NimNode): NimTypeDef =
               case n.kind
               of nnkExprEqExpr:
                 if "write".eqIdent(n[0]):
-                  write = n[1].boolVal
+                  write = qpropertyFlag(n[0], n[1])
                 elif "notify".eqIdent(n[0]):
-                  notify = n[1].boolVal
+                  notify = qpropertyFlag(n[0], n[1])
                 else:
-                  raisEAssert "Unkown property"
+                  error("Unknown qproperty argument: " & repr(n[0]), n[0])
               else:
                 raiseAssert "unexpected param " & $n.kind
 
