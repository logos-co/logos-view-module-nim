From 21c81da28690fab1f81cd6a42273d2b740d9d5bb Mon Sep 17 00:00:00 2001
From: Dario Gabriel Lipicar <lipigl@gmail.com>
Date: Thu, 30 Jul 2026 00:02:15 -0300
Subject: [PATCH 1/5] Don't publish property accessors as slots

`qproperty` synthesised a read slot and a write slot for every property and
registered both in the method table. `moc` does not do this: a Q_PROPERTY is
reached through qt_metacall(ReadProperty/WriteProperty), and only methods the
author actually declared appear as invokable.

Publishing them has two visible consequences:

  * QML sees `foo` as both a property and a method. QQmlPropertyCache appends
    methods before properties and setNamedProperty overwrites, so the property
    happens to win today, but that is an implementation detail to be relying on.

  * QtRemoteObjects' DynamicApiMap replicates every slot, so a remoted object
    grows `setFoo`/`foo` methods on the replica side and the method indices no
    longer line up with an equivalent .rep-derived interface.

Keep synthesising the accessor procs -- they are the Nim-facing API and the
property metacall calls straight through them -- but hold them in a separate
`accessors` list that never reaches `slotsLit`. An accessor the author declared
explicitly as a `{.slot.}` is still honoured, and still stays a slot.

nimside's metacall already routed ReadProperty/WriteProperty through these
procs, so no behaviour is lost; the method table just stops advertising them.

tests/test_all: 22 OK.
---
 src/nimside.nim | 36 ++++++++++++++++++++++++++++++------
 1 file changed, 30 insertions(+), 6 deletions(-)

diff --git a/src/nimside.nim b/src/nimside.nim
index 25e3241..09d50ee 100644
--- a/src/nimside.nim
+++ b/src/nimside.nim
@@ -90,6 +90,14 @@ type
     props: seq[NimPropDef]
     signals: seq[NimMethodDef]
     slots: seq[NimMethodDef]
+    # Property read/write accessors that we synthesise for `{.qproperty.}`
+    # fields. These are deliberately NOT in `slots`: `moc` does not publish
+    # property accessors as invokable methods, it reaches them through
+    # qt_metacall(ReadProperty/WriteProperty), and so do we. Keeping them out
+    # of the method table matters to anything that enumerates methods --
+    # QtRemoteObjects' DynamicApiMap replicates every slot, and QML's
+    # QQmlPropertyCache would see `foo` as both a property and a method.
+    accessors: seq[NimMethodDef]
 
 proc isVoid(v: NimNode): bool =
   v.kind == nnkEmpty or "void".eqIdent(v)
@@ -327,6 +335,22 @@ proc processType(p: var NimTypeDef): (NimNode, NimNode) =
         break
     idx
 
+  template findAccessor(n: string): int =
+    var idx = -1
+    for i in 0 ..< p.accessors.len:
+      if n.eqIdent(p.accessors[i].name):
+        idx = i
+        break
+    idx
+
+  # A property accessor is either one the user declared explicitly as a
+  # `{.slot.}` -- in which case it stays a slot and we call it as such -- or one
+  # we synthesised, which lives in `accessors` and is invisible to the method
+  # table. Either way the property metacall needs its definition.
+  template findPropAccessor(n: string): NimMethodDef =
+    let slotIdx = findSlot(n)
+    if slotIdx >= 0: p.slots[slotIdx] else: p.accessors[findAccessor(n)]
+
   let
     voidTyp = ident"void"
     staticMetaObject = ident("staticMetaObject")
@@ -357,13 +381,13 @@ proc processType(p: var NimTypeDef): (NimNode, NimNode) =
           nil
 
     if prop.def.writeSlot.len > 0 and findSlot(prop.def.writeSlot) < 0:
-      p.slots.add NimMethodDef(
+      p.accessors.add NimMethodDef(
         name: ident prop.def.writeSlot,
         returnType: voidTyp,
         params: @[NimParamDef(name: ident "newValue", typ: prop.typ)],
       )
 
-      let writeSlotLit = p.slots[^1].name
+      let writeSlotLit = p.accessors[^1].name
 
       if signalNameLit != nil:
         pre.add quote do:
@@ -378,10 +402,10 @@ proc processType(p: var NimTypeDef): (NimNode, NimNode) =
             o.`propName` = v
 
     if prop.def.readSlot.len > 0 and findSlot(prop.def.readSlot) < 0:
-      p.slots.add NimMethodDef(
+      p.accessors.add NimMethodDef(
         name: ident(prop.def.readSlot), returnType: propType, params: @[]
       )
-      let slotName = p.slots[^1].name
+      let slotName = p.accessors[^1].name
       pre.add quote do:
         proc `slotName`*(o: `typName`): lent `propType` =
           o.`propName`
@@ -561,7 +585,7 @@ proc processType(p: var NimTypeDef): (NimNode, NimNode) =
 
   for i, prop in props:
     if prop.def.readSlot.len > 0:
-      let slot = p.slots[findSlot(prop.def.readSlot)]
+      let slot = findPropAccessor(prop.def.readSlot)
       if canConstruct(slot):
         readPropCase.add nnkOfBranch.newTree(
           newLit(i), genMethodCall(slot, slot.name, self, argv, newLit(1))
@@ -571,7 +595,7 @@ proc processType(p: var NimTypeDef): (NimNode, NimNode) =
           slot.name.strVal, slot.name
 
     if prop.def.writeSlot.len > 0:
-      let slot = p.slots[findSlot(prop.def.writeSlot)]
+      let slot = findPropAccessor(prop.def.writeSlot)
       if canConstruct(slot):
         writePropCase.add nnkOfBranch.newTree(
           newLit(i), genMethodCall(slot, slot.name, self, argv, newLit(0))
